# Build-time variables baked into src/environments/environment.ts by load-env.js.
# Copied to .env by `bun install` (scripts/prepare-env.js). Never commit .env.

# DEV | PROD — sets environment.production
NODE_ENV=DEV

# Gateway base URL (the MF calls `${API_URL}/<ms-prefix>/...`)
API_URL=http://localhost:3000

# MUST be identical to the host (frontcontainer) SECRET_KEY: the access token
# is stored by the host in encrypted localStorage and read here with this key.
# encrypt-storage requires at least 10 characters.
SECRET_KEY=change-me-use-the-host-secret

# Root entity code of the deployment
ENTITY_ROOT=ROOT

# Optional: skip the best-effort GET ${API_URL}/ms-core/parameter/env
# SKIP_ENV_FETCH=1
# ENV_FETCH_TIMEOUT_MS=5000
