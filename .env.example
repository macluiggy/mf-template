# Build-time variables baked into src/environments/environment.ts by load-env.js.
# Copied to .env by `bun install` (scripts/prepare-env.js). Never commit .env.

# DEV | PROD sets environment.production
NODE_ENV=DEV

# Generic (required): gateway base URL (the app calls `${API_URL}/<ms-prefix>/...`)
API_URL=http://localhost:3000

# --- NEOCORE preset (optional) ---------------------------------------------
# Only the NEOCORE integration (provideNeocoreHost()) needs these three.
# SECRET_KEY: encrypts the access token — identical to the host's, 10+ characters.
# SECRET_KEY=change-me-use-the-host-secret
# ENTITY_ROOT: root entity code of the deployment.
# ENTITY_ROOT=ROOT
# ENV_REMOTE_URL: full URL of the remote env document (NEOCORE: ${API_URL}/ms-core/parameter/env).
# ENV_REMOTE_URL=http://localhost:3000/ms-core/parameter/env

# Optional: hard off switch for the remote config fetch.
# SKIP_ENV_FETCH=1
# Optional: timeout of the remote config fetch, default 5000.
# ENV_FETCH_TIMEOUT_MS=5000
