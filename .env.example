# Build-time variables baked into src/environments/environment.ts by load-env.js.
# Copied to .env by `bun install` (scripts/prepare-env.js). Never commit .env.
# Everything here ends up in the public bundle: no server-side secrets.

# DEV | PROD — sets environment.production
NODE_ENV=DEV

# Backend base URL (services call `${API_URL}/<resource>`)
API_URL=http://localhost:3000

# Key used by StorageService to encrypt localStorage (encrypt-storage, >= 10 chars).
# Changing it makes previously stored values unreadable (users are logged out).
SECRET_KEY=change-me-at-least-10-chars
