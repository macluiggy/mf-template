{
  "name": "front-template-standalone",
  "version": "0.1.0",
  "description": "Standalone Angular application template (no Native Federation, no host)",
  "private": true,
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "ng": "ng",
    "prepare": "node scripts/prepare-env.js",
    "env": "node load-env.js",
    "start": "node load-env.js && ng serve",
    "build": "node load-env.js && ng build",
    "watch": "node load-env.js && ng build --watch --configuration development",
    "test": "node load-env.js && ng test --watch=false && bun run test:scripts",
    "test:watch": "node load-env.js && ng test",
    "test:scripts": "node --test 'scripts/**/*.test.js'",
    "lint": "biome lint --max-diagnostics=999",
    "lint:fix": "biome lint --write --max-diagnostics=999",
    "format": "biome format --write --max-diagnostics=999",
    "check": "biome check --max-diagnostics=999",
    "generate:module": "node scripts/generate-module.js"
  },
  "dependencies": {
    "@angular/common": "22.1.7",
    "@angular/compiler": "22.1.7",
    "@angular/core": "22.1.7",
    "@angular/forms": "22.1.7",
    "@angular/platform-browser": "22.1.7",
    "@angular/router": "22.1.7",
    "encrypt-storage": "3.0.4",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.1.8",
    "@angular/cli": "22.1.8",
    "@angular/compiler-cli": "22.1.7",
    "@biomejs/biome": "^2.4.16",
    "@types/node": "^22.13.4",
    "dotenv": "^17.4.2",
    "jsdom": "30.0.1",
    "typescript": "~6.0.3",
    "vitest": "5.0.1"
  }
}
